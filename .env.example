# Okta Configuration
# Your Okta org domain — no "https://", just the domain
# Example: dev-12345678.okta.com
OKTA_DOMAIN=your-org.okta.com

# Okta API Token
# Generate one in Okta Admin Console: Security > API > Tokens > Create Token
# The token needs read access to users, groups, and apps
OKTA_API_TOKEN=your-okta-api-token-here

# Anthropic API Key
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here
